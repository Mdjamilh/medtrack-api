# Optional. Without it the API uses an embedded PGlite database in .pglite/
# (migrated automatically). With it, run `npm run db:migrate` first.
DATABASE_URL=

# Required in production: at least 32 random characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

PORT=4000
# Comma-separated allowed origins, or * for any.
CORS_ORIGINS=*
LOG_LEVEL=info
# Login/register attempts per IP per minute.
AUTH_RATE_LIMIT=10
